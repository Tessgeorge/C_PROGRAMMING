#include <stdio.h>

int main() {
    int n, i;
    int fact = 1; // 1. Changed 'long long' to 'int'. Started at 1.

    printf("Enter a number: ");
    scanf("%d", &n);

    // 2. The Loop (The Rolling Snowball)
    for(i = 1; i <= n; i++) {
        fact = fact * i; 
    }

    printf("Factorial = %d", fact); // 3. Changed %lld to %d

    return 0;
}
